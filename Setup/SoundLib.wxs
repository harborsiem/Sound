  <Fragment>
    <DirectoryRef Id="TARGETDIR">
      <Merge Id="VCRedist" SourceFile="..\CSound\MergeModules\Microsoft_VC141_CRT_x86.msm" DiskId="1" Language="0" />
    </DirectoryRef>
  </Fragment>
