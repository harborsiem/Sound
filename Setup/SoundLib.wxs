<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="SoundLib" Language="1033" Version="25.0.0.0" Manufacturer="Harbor" UpgradeCode="{AAA36C46-C19C-4217-96E7-E97FAF3DA38C}" InstallerVersion="301" ProductCode="{7C97F4C4-7F72-4DBF-96B8-21C0C8D346EB}">
    <SummaryInformation Description="Sound Library for .NET and .NET Framework 4" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <Media Id="1" Cabinet="Data.cab" EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="Sound Setup for native components" Level="1">
      <ComponentGroupRef Id="ProductComponents1" />
      <ComponentGroupRef Id="ProductComponents2" />
      <ComponentGroupRef Id="ProductComponents3" />
    </Feature>
    <UI />
    <ui:WixUI Id="WixUI_Minimal" />
    <UIRef Id="WixUI_ErrorProgressText" />
    <WixVariable Id="WixUILicenseRtf" Value="GPLv2_License.rtf" />
  </Package>

  <Fragment>
      <StandardDirectory Id="ProgramFilesFolder">
      </StandardDirectory>
      <StandardDirectory Id="WindowsFolder">
        <Directory Id="Di.Microsoft.NET" Name="Microsoft.NET">
          <Directory Id="Di.Sound" Name="Sound">
            <Directory Id="Di.x86" Name="x86">
            </Directory>
            <Directory Id="Di.x64" Name="x64">
            </Directory>
          </Directory>
        </Directory>
      </StandardDirectory>
    </Fragment>

