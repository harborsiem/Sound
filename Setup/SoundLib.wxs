  <Fragment>
    <ComponentGroup Id="ProductComponents1" Directory="Di.Sound">
      <Component Id="C.Sound.config" DiskId="1" Guid="7268C72E-A902-409B-819D-D0122DE8B08D">
        <File Id="Fi.Sound.config" Name="sound.config" Source="..\Sound\config\sound.config" />
      </Component>
    </ComponentGroup>
  </Fragment>
  <Fragment>
    <ComponentGroup Id="ProductComponents2" Directory="Di.x86">
      <Component Id="C.Sound_C_x86" Guid="C32441A7-C33D-481E-84AA-26133615A947">
        <File Id="Fi.CSoundDllx86" Name="CSound.dll" Source="..\CSound\Release\CSound.dll" KeyPath="yes" />
      </Component>
    </ComponentGroup>
    <ComponentGroup Id="ProductComponents3" Directory="Di.x64">
      <Component Id="C.Sound_C_x64" Guid="{5237F02C-D31E-4577-B854-9D7AB46B72E7}">
        <File Id="Fi.CSoundDllx64" Name="CSound.dll" Source="..\CSound\x64\Release\CSound.dll" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
